diff --git a/ucm/integration/vllm/prefetch_server.py b/ucm/integration/vllm/prefetch_server.py
new file mode 100644
index 0000000..ec72253
--- /dev/null
+++ b/ucm/integration/vllm/prefetch_server.py
@@ -0,0 +1,122 @@
+# SPDX-License-Identifier: Apache-2.0
+"""UCM 进程内 HTTP 端点:择机预取(调 UCM dispatcher 的 prefetch_data)。
+
+监听于 worker 进程,按 rank 绑定 base_port + local_rank,供 vllm-router 预取端点
+(/kv/prefetch)路由到对应 rank 后触发 CacheStore::Warm(Backend2Cache,SSD -> DDR)。
+仅依赖标准库,不反向依赖 vllm-ascend。
+"""
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from typing import Callable, List, Optional
+
+from ucm.logger import init_logger
+
+logger = init_logger(__name__)
+
+# UCM BlockId 是 16 字节哈希(std::array<std::byte, 16>),hex 表示即 32 字符。
+# 长度不符会在 BufferArrayView 里被整除截断(num=0),导致 Warm 收到空任务;
+# 此处直接拒绝,避免下游空任务永久挂起。
+_UCM_BLOCK_ID_BYTES = 16
+
+
+class _PrefetchHandler(BaseHTTPRequestHandler):
+    server_version = "UcmPrefetchServer/1.0"
+
+    @property
+    def prefetch_fn(self) -> Callable[[List[bytes]], None]:
+        return self.server.prefetch_fn
+
+    @property
+    def token(self) -> Optional[str]:
+        return getattr(self.server, "token", None)
+
+    @property
+    def lock(self) -> threading.Lock:
+        return self.server.lock
+
+    def _authorized(self) -> bool:
+        if not self.token:
+            return True
+        return self.headers.get("Authorization", "") == f"Bearer {self.token}"
+
+    def _send_json(self, status: int, obj: dict) -> None:
+        body = json.dumps(obj).encode("utf-8")
+        self.send_response(status)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def _read_body(self) -> dict:
+        length = int(self.headers.get("Content-Length", "0"))
+        if length <= 0:
+            return {}
+        return json.loads(self.rfile.read(length).decode("utf-8"))
+
+    @staticmethod
+    def _parse_block_ids(body: dict) -> List[bytes]:
+        raw = body.get("block_ids")
+        if not isinstance(raw, list):
+            raise ValueError("'block_ids' must be an array of hex strings")
+        block_ids: List[bytes] = []
+        for h in raw:
+            try:
+                bid = bytes.fromhex(str(h))
+            except ValueError:
+                raise ValueError(f"invalid hex block id: {h!r}")
+            if len(bid) != _UCM_BLOCK_ID_BYTES:
+                raise ValueError(
+                    f"block id must be {_UCM_BLOCK_ID_BYTES * 2} hex chars "
+                    f"({_UCM_BLOCK_ID_BYTES} bytes), got {h!r}"
+                )
+            block_ids.append(bid)
+        return block_ids
+
+    def do_GET(self) -> None:
+        if self.path == "/healthy":
+            self._send_json(200, {"ok": True})
+        else:
+            self._send_json(404, {"ok": False, "error": "not found"})
+
+    def do_POST(self) -> None:
+        if not self._authorized():
+            self._send_json(401, {"ok": False, "error": "unauthorized"})
+            return
+        try:
+            body = self._read_body()
+            if self.path == "/kv/prefetch":
+                block_ids = self._parse_block_ids(body)
+                with self.lock:
+                    self.prefetch_fn(block_ids)
+                self._send_json(200, {"ok": True, "count": len(block_ids)})
+            else:
+                self._send_json(404, {"ok": False, "error": "not found"})
+        except Exception as e:  # noqa: BLE001
+            logger.warning("UCM prefetch HTTP error: %s", e)
+            self._send_json(400, {"ok": False, "error": str(e)})
+
+    def log_message(self, fmt: str, *args) -> None:
+        logger.debug("ucm-prefetch-http: " + fmt, *args)
+
+
+class UcmPrefetchServer:
+    def __init__(self, prefetch_fn: Callable[[List[bytes]], None], host: str,
+                 port: int, token: Optional[str] = None) -> None:
+        self.lock = threading.Lock()
+        self._server = ThreadingHTTPServer((host, port), _PrefetchHandler)
+        self._server.prefetch_fn = prefetch_fn
+        self._server.token = token
+        self._server.lock = self.lock
+        self._thread = threading.Thread(
+            target=self._server.serve_forever, name="ucm-prefetch-http", daemon=True
+        )
+
+    def start(self) -> "UcmPrefetchServer":
+        self._thread.start()
+        logger.info("UCM prefetch HTTP started on %s", self._server.server_address)
+        return self
+
+    def stop(self) -> None:
+        self._server.shutdown()
+        self._server.server_close()
