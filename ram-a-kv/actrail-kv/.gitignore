# Generated by Cargo
# will have compiled files and executables
/target/

# Local agent configuration
/.agents

# Cargo.lock is committed because this workspace ships executable binaries.

# These are backup files generated by rustfmt
**/*.rs.bk

# dev files should be kept local
/dev/


# Local storage configuration and runtime output
/storage.json
/sqlite.json
/ndjson.json
/captures/
/data/
/requests.ndjson
/exported.ndjson
/analysis.json
/report.html
/report.md

# SQLite databases and their companion files
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.db
*.db-wal
*.db-shm
*.db-journal

# Managed NDJSON files under a custom storage directory
capture_*_*_*_*.ndjson
.writer.lock
.snapshot.lock
